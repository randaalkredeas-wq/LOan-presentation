# InvestGuard — environment variables
#
# The app currently runs entirely on mock data (see src/services/mockPortfolioService.ts)
# and requires NO environment variables or API keys to run.
#
# These are placeholders for when a real data source is wired up later
# (see README.md "Connecting real data" section). Never commit a real
# .env file — .env* is already git-ignored.

# --- Future: PortfolioApiService (brokerage / aggregation API) ---
# INVESTGUARD_API_BASE_URL=
# INVESTGUARD_API_KEY=

# --- Future: PortfolioDatabaseService ---
# DATABASE_URL=

# --- Future: FX rate provider (if replacing the static rates in src/data/fx.ts) ---
# FX_RATES_API_KEY=
