// 1R. Studio — Photography Business Management Platform
// Prisma schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// CATALOG — Services & Packages (source of truth: 1R. Studio package sheets)
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameEn      String
  nameAr      String
  descriptionEn String
  descriptionAr String
  coverImage  String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  packages    Package[]
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Package {
  id              String   @id @default(cuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slug            String   @unique
  nameEn          String
  nameAr          String
  descriptionEn   String
  descriptionAr   String
  price           Decimal  @db.Decimal(10, 2)
  depositAmount   Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  directCost      Decimal  @db.Decimal(10, 2) // editable estimated production/direct cost per booking, drives profitability
  badgeEn         String?
  badgeAr         String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  inclusions      PackageInclusion[]
  addons          AddonOption[]
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PackageInclusion {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  textEn    String
  textAr    String
  sortOrder Int     @default(0)
}

model AddonOption {
  id         String       @id @default(cuid())
  packageId  String
  package    Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  nameEn     String
  nameAr     String
  price      Decimal      @db.Decimal(10, 2)
  isActive   Boolean      @default(true)
  orderAddons OrderAddon[]
}

// ─────────────────────────────────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  notes     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

// ─────────────────────────────────────────────────────────────────────────
// BOOKING / ORDERS
// ─────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  NEW
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum OrderSource {
  WEBSITE
  MANUAL
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id])
  serviceId             String
  service               Service       @relation(fields: [serviceId], references: [id])
  packageId             String
  package               Package       @relation(fields: [packageId], references: [id])
  eventDate             DateTime      @db.Date
  eventTime             String? // e.g. "09:00" — matches TimeSlot.label; null = date-only booking
  location              String?
  additionalRequirements String?
  notes                 String?
  packagePriceSnapshot  Decimal       @db.Decimal(10, 2)
  addonsTotalSnapshot   Decimal       @db.Decimal(10, 2) @default(0)
  total                 Decimal       @db.Decimal(10, 2)
  directCostSnapshot    Decimal       @db.Decimal(10, 2) // package.directCost at time of booking
  depositAmount         Decimal       @db.Decimal(10, 2)
  status                OrderStatus   @default(NEW)
  paymentStatus         PaymentStatus @default(UNPAID)
  source                OrderSource   @default(WEBSITE)
  addons                OrderAddon[]
  payments              Payment[]
  slotLock              BookingSlotLock?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  cancelledAt            DateTime?
  completedAt            DateTime?

  @@index([eventDate])
  @@index([status])
  @@index([customerId])
}

model OrderAddon {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addonOptionId String?
  addonOption   AddonOption? @relation(fields: [addonOptionId], references: [id])
  nameEnSnapshot String
  nameArSnapshot String
  priceSnapshot Decimal     @db.Decimal(10, 2)
  qty           Int         @default(1)
}

// Guarantees atomic, DB-enforced double-booking prevention:
// one row per (eventDate, eventTime) while a booking actively holds it.
model BookingSlotLock {
  id        String   @id @default(cuid())
  eventDate DateTime @db.Date
  eventTime String // "09:00" or "ALL_DAY" for date-only services
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventDate, eventTime])
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  method    String // CASH, BANK_TRANSFER, CARD, OTHER
  type      String // DEPOSIT, BALANCE, REFUND
  paidAt    DateTime @default(now())
  note      String?
}

// ─────────────────────────────────────────────────────────────────────────
// AVAILABILITY
// ─────────────────────────────────────────────────────────────────────────

model TimeSlot {
  id        String  @id @default(cuid())
  label     String  @unique // "09:00"
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

enum BlockedDateType {
  VACATION
  BLOCKED
  FULLY_BOOKED
  CUSTOM
}

model BlockedDate {
  id          String          @id @default(cuid())
  date        DateTime        @db.Date
  isFullDay   Boolean         @default(true)
  blockedSlots String[]       @default([]) // subset of TimeSlot labels if not full day
  type        BlockedDateType @default(BLOCKED)
  reason      String?
  createdAt   DateTime        @default(now())

  @@unique([date])
}

// ─────────────────────────────────────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────────────────────────────────────

enum ExpenseType {
  DIRECT
  OPERATING
}

model ExpenseCategory {
  id       String      @id @default(cuid())
  nameEn   String
  nameAr   String
  type     ExpenseType
  isCustom Boolean     @default(false)
  expenses Expense[]
}

model Expense {
  id            String          @id @default(cuid())
  name          String
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount        Decimal         @db.Decimal(10, 2)
  date          DateTime        @db.Date
  expenseType   ExpenseType
  isRecurring   Boolean         @default(false)
  paymentMethod String // CASH, BANK_TRANSFER, CARD, OTHER
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────
// KRI ENGINE
// ─────────────────────────────────────────────────────────────────────────

enum KriCategory {
  FINANCIAL
  OPERATIONAL
}

enum RiskDirection {
  HIGHER_IS_RISK
  LOWER_IS_RISK
}

model KriDefinition {
  id                String        @id @default(cuid())
  code              String        @unique
  nameEn            String
  nameAr            String
  category          KriCategory
  descriptionEn     String
  descriptionAr     String
  unit              String // PERCENT, CURRENCY, NUMBER
  direction         RiskDirection
  thresholdYellow   Decimal       @db.Decimal(10, 2)
  thresholdOrange   Decimal       @db.Decimal(10, 2)
  thresholdRed      Decimal       @db.Decimal(10, 2)
  recommendedActionEn String
  recommendedActionAr String
  isActive          Boolean       @default(true)
  results           KriResult[]
  sortOrder         Int           @default(0)
}

model KriResult {
  id              String        @id @default(cuid())
  kriDefinitionId String
  kriDefinition   KriDefinition @relation(fields: [kriDefinitionId], references: [id], onDelete: Cascade)
  periodLabel     String // "2026-01" monthly snapshot key
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  value           Decimal       @db.Decimal(12, 2)
  riskLevel       String // GREEN, YELLOW, ORANGE, RED
  computedAt      DateTime      @default(now())

  @@unique([kriDefinitionId, periodLabel])
  @@index([periodStart])
}

model Alert {
  id                 String   @id @default(cuid())
  kriCode            String?
  titleEn            String
  titleAr            String
  messageEn          String
  messageAr          String
  severity           String // GREEN, YELLOW, ORANGE, RED
  recommendedActionEn String
  recommendedActionAr String
  periodLabel        String
  isResolved         Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([severity])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────────────────────────────────

model Settings {
  id                  String   @id @default("singleton")
  businessNameEn      String   @default("1R. Studio")
  businessNameAr      String   @default("استوديو ون آر")
  currency            String   @default("SAR")
  workingDays         Int[]    @default([0, 1, 2, 3, 4, 6]) // 0=Sun..6=Sat, Friday(5) off by default
  slotDurationMinutes Int      @default(240)
  fixedCostsMonthly   Decimal  @db.Decimal(10, 2) @default(6000)
  healthScoreWeights  Json     @default("{\"revenueGrowth\":15,\"orderGrowth\":10,\"netMargin\":25,\"expenseRatio\":20,\"breakEven\":15,\"cancellationRate\":10,\"outstandingPayments\":5}")
  updatedAt           DateTime @updatedAt
}
